{
  "openapi": "3.0.0",
  "info": {
    "title": "Simulator Télos - Movie API",
    "description": "API for managing movie and user catalogs",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Movie": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "663a7f8e1c2b3a4d5e6f7a8b" },
          "title": { "type": "string", "example": "Inception" },
          "description": { "type": "string" },
          "year": { "type": "integer" },
          "genres": { "type": "array", "items": { "type": "string" } },
          "image": { "type": "string" },
          "video": { "type": "string" }
        }
      },
      "MovieInput": {
        "type": "object",
        "required": ["title", "description", "year", "genres", "image", "video"],
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "year": { "type": "integer" },
          "genres": { "type": "array", "items": { "type": "string" } },
          "image": { "type": "string" },
          "video": { "type": "string" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": "string" }
        }
      },
      "UserInput": {
        "type": "object",
        "required": ["name", "email", "password"],
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string" },
          "password": { "type": "string" }
        }
      }
    }
  },
  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Log in and obtain a JWT Token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "example": "hugo2@email.com" },
                  "password": { "type": "string", "example": "senhaSegura2123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/movies": {
      "get": {
        "summary": "List all movies (Public)",
        "tags": ["Movies"],
        "responses": {
          "200": { "description": "Success" }
        }
      },
      "post": {
        "summary": "Create new movie (Protected)",
        "security": [{ "bearerAuth": [] }],
        "tags": ["Movies"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MovieInput" }
            }
          }
        },
        "responses": {
          "201": { "description": "Created successfully" },
          "401": { "description": "Token not provided or invalid" }
        }
      }
    },
    "/movies/{id}": {
      "get": {
        "summary": "Search for movie by ID",
        "tags": ["Movies"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Sucess" } }
      },
      "put": {
        "summary": "Update movie (Protected)",
        "security": [{ "bearerAuth": [] }],
        "tags": ["Movies"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MovieInput" } } }
        },
        "responses": { "200": { "description": "Updated" } }
      },
      "delete": {
        "summary": "Delete movie (Protected)",
        "security": [{ "bearerAuth": [] }],
        "tags": ["Movies"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "204": { "description": "Deleted" } }
      }
    },
    "/users": {
      "get": {
        "summary": "List users (Protected)",
        "security": [{ "bearerAuth": [] }],
        "tags": ["Users"],
        "responses": { "200": { "description": "Sucess" } }
      },
      "post": {
        "summary": "Create new user",
        "tags": ["Users"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserInput" } } }
        },
        "responses": { "201": { "description": "Created" } }
      }
    }
  }
}